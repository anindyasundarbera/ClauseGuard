# Firebase Web App Configuration (safe client identifiers; obtain from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Production App Check site key (reCAPTCHA Enterprise). Public identifier, safe to ship; the hosted domain
# must be added to this key's allowed domains. Required for any hosted (non-localhost) cloud call.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local Development ONLY (ignored on any non-localhost origin): set to "true" or your private safelisted UUID in local untracked .env
# NEVER commit a real App Check debug token or .env file to version control!
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional cloud model override (must be a supported Gemini 3+ / 4 model: gemini-3.5-flash-lite, gemini-3.8-flash, or gemini-4-hydrogen)
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite

# Optional: set to "true" if Firebase App Check Replay Protection (limited-use tokens) is enabled in Console
VITE_FIREBASE_USE_LIMITED_USE_APPCHECK=false
